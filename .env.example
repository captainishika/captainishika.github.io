# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# --- AI assistant (/api/chat) ---------------------------------------------
# Required for the "Ask AI" chat. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional model override (defaults to deepseek-chat, the low-cost model)
CHAT_MODEL=

# --- Contact form (/api/contact) -------------------------------------------
# Messages are delivered by email through Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=ishikabhatnagar7307@gmail.com
# Must be a sender on a domain verified in Resend. The default only works for testing,
# and Resend's test sender can only deliver to the email address of the Resend account owner.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- CORS -------------------------------------------------------------------
# Extra origins allowed to call the API (comma-separated).
# https://captainishika.github.io and http://localhost:3000 are always allowed.
ALLOWED_ORIGINS=

# --- Public (baked into the frontend at build time) -------------------------
NEXT_PUBLIC_SITE_URL=https://captainishika.github.io
# Leave empty on Vercel (same origin). The GitHub Pages build sets this to the Vercel URL.
NEXT_PUBLIC_API_BASE_URL=
